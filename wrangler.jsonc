{
  "name": "mi-diario-nutricional",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {"directory": "dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "mi-diario-nutricional"}],
  "env": {"preview": {
    "vars": {"LOCAL_PREVIEW": "1"},
    "r2_buckets": [{"binding": "BUCKET", "bucket_name": "mi-diario-nutricional"}],
    "assets": {"directory": "dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]}
  }}
}
